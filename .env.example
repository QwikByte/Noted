# Kopieren nach .env und anpassen. Alle Werte sind optional.

# Erstes Admin-Konto (wird nur beim allerersten Start angelegt).
# Ohne ADMIN_PASSWORD wird ein zufälliges Passwort erzeugt und einmalig im Log ausgegeben:
#   docker compose logs noted
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=ein-langes-sicheres-passwort

# Öffentliche Adresse der App (für die Herkunftsprüfung bei Anfragen)
# APP_URL=https://notizen.example.com

# Schlüssel zur Verschlüsselung der MFA-Geheimnisse in der Datenbank.
# Ohne Angabe wird automatisch einer erzeugt und unter /data/secret.key gespeichert.
# SECRET_KEY=

# Name in der Authenticator-App
# APP_NAME=Noted

# Session-Cookie nur über HTTPS senden: auto (Standard, anhand von X-Forwarded-Proto), true oder false
# COOKIE_SECURE=auto

# Bilder von fremden Servern in Notizen anzeigen (Standard: true). Mit false bleiben nur eigene Dateien sichtbar –
# ein externes Bild verrät dem fremden Server sonst bei jedem Öffnen die IP-Adresse.
# EXTERNAL_IMAGES=true


# Grenzen
# MAX_UPLOAD_MB=25
# MAX_IMPORT_MB=200
# SESSION_DAYS=30
# TRASH_DAYS=30
